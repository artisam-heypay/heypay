# .env.example — placeholders only; never commit real values.
# Copy to .env and fill in. Authoritative list for HeyPay (all phases).

# --- App ---
NODE_ENV=development
APP_URL=http://localhost:3000
PORT=3000
LOG_LEVEL=info
SESSION_SECRET=replace-with-long-random-string
SIGNUP_RATE_LIMIT=5                     # max signups per IP per hour (raise for e2e/load tests)
ENCRYPTION_MASTER_KEY=base64:replace-with-32-byte-key   # AES-256-GCM master key
ENCRYPTION_KEY_VERSION=1
# Optional key-rotation slots (test-only; leave empty in normal dev)
ENCRYPTION_MASTER_KEY_V1=
ENCRYPTION_MASTER_KEY_V2=

# --- Database (Postgres) ---
# Web service on Railway should use the POOLED connection string.
DATABASE_URL=postgresql://heypay:heypay@localhost:5432/heypay?schema=public
SHADOW_DATABASE_URL=postgresql://heypay:heypay@localhost:5432/heypay_shadow?schema=public

# --- Redis / queue ---
REDIS_URL=redis://localhost:6379

# --- Seeded admin ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-me-strong
SEED_DEMO=true

# --- Stellar ---
STELLAR_NETWORK=testnet
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
# Set to 1 to run live Horizon integration tests (testnet only).
RUN_STELLAR_IT=

# --- Payment assets (feature flag) ---
# Assets the payment pipeline accepts. Comma-separated; empty = XLM only.
# Every enabled asset must be receivable by the HeyPay treasury (an issued asset
# needs a treasury trustline). USDT is off until the treasury trusts its issuer.
PAYMENT_ASSETS=XLM,USDC
# Issuer account (G...) for each issued asset. USDC/USDT on Stellar are
# `code:issuer` pairs — the same code from another issuer is a different, likely
# worthless, asset.
#   testnet: defaults to Circle's Centre testnet issuer
#            (GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5), which
#            issues both USDC and USDT. Leave blank to use it, or mint your own:
#            node scripts/stellar-issue-test-asset.mjs USDT
#   mainnet: REQUIRED. No default — verify the canonical issuer on
#            stellar.expert before pointing real money at it.
USDT_ASSET_ISSUER=
USDC_ASSET_ISSUER=

# --- Payment rail ---
# mock = deterministic local rail (dev/CI). xendit = payer crypto goes to the
# HeyPay treasury, merchant is paid PHP via a Xendit payout.
PAYMENT_RAIL=mock                     # mock | xendit

# --- HeyPay treasury (Stellar account that receives every payer's crypto) ---
HEYPAY_TREASURY_PUBLIC_KEY=
# Envelope-encrypted treasury secret (same scheme as custodial wallets). Used
# only to send crypto back when a payment is refunded. Never commit the raw S...
HEYPAY_TREASURY_SECRET_ENC=

# --- Xendit payouts ---
XENDIT_SECRET_KEY=                    # xnd_development_... (test) / xnd_production_... (live)
# Dashboard → Settings → Webhooks: the verification token Xendit sends in
# x-callback-token. Point the payout webhook at /api/webhooks/xendit.
XENDIT_CALLBACK_TOKEN=
# Comma-separated (max 3) HeyPay addresses cc'd on every Xendit payout receipt.
XENDIT_RECEIPT_CC=

# --- Live rates (xendit rail) ---
# Primary price is the Coins.ph order-book bid (no key). CoinMarketCap is the
# backup; quotes are refused when the two disagree by more than the limit below.
CMC_API_KEY=
RATE_MAX_DIVERGENCE_BPS=200           # 200 = 2%
CMC_CACHE_MS=60000                    # reuse a CoinMarketCap answer this long (credit budget)

# --- Mock rail tuning (dev/CI only; ignored when PAYMENT_RAIL=xendit) ---
MOCK_XLM_PHP_RATE=3.50
MOCK_USDT_PHP_RATE=58.00
MOCK_USDC_PHP_RATE=58.00
MOCK_RAIL_DELAY_MS=0
MOCK_FAIL_PHP_AMOUNT=                  # optional: a PHP amount that forces payout failure (e2e/demo)

# --- Object storage (MinIO dev / Railway prod, S3-compatible) ---
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_URL=http://localhost:9000   # base for signed GET URLs (prod: bucket/CDN URL)
S3_REGION=us-east-1
S3_BUCKET=heypay-uploads
S3_ACCESS_KEY=heypay
S3_SECRET_KEY=heypay-secret
S3_FORCE_PATH_STYLE=true              # true for MinIO; false for a real S3 endpoint

# --- Observability (optional) ---
SENTRY_DSN=

# --- E2E test overrides (used by playwright.config.ts; defaults shown) ---
E2E_PORT=3100
E2E_DATABASE_URL=postgresql://heypay:heypay@localhost:5433/heypay_e2e?schema=public
E2E_REDIS_URL=redis://localhost:6380
