# .env.example — placeholders only; never commit real values.
# Copy to .env and fill in. Authoritative list for HeyPay (all phases).

# --- App ---
NODE_ENV=development
APP_URL=http://localhost:3000
PORT=3000
LOG_LEVEL=info
SESSION_SECRET=replace-with-long-random-string
SIGNUP_RATE_LIMIT=5                     # max signups per IP per hour (raise for e2e/load tests)
ENCRYPTION_MASTER_KEY=base64:replace-with-32-byte-key   # AES-256-GCM master key
ENCRYPTION_KEY_VERSION=1
# Optional key-rotation slots (test-only; leave empty in normal dev)
ENCRYPTION_MASTER_KEY_V1=
ENCRYPTION_MASTER_KEY_V2=

# --- Database (Postgres) ---
# Web service on Railway should use the POOLED connection string.
DATABASE_URL=postgresql://heypay:heypay@localhost:5432/heypay?schema=public
SHADOW_DATABASE_URL=postgresql://heypay:heypay@localhost:5432/heypay_shadow?schema=public

# --- Redis / queue ---
REDIS_URL=redis://localhost:6379

# --- Seeded admin ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-me-strong
SEED_DEMO=true

# --- Stellar ---
STELLAR_NETWORK=testnet
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
# Set to 1 to run live Horizon integration tests (testnet only).
RUN_STELLAR_IT=

# --- Payment assets (feature flag) ---
# Assets the payment pipeline accepts. Comma-separated; empty = XLM only.
# On testnet, XLM,USDC,USDT works with no further config (issuers default below).
PAYMENT_ASSETS=XLM,USDC,USDT
# Issuer account (G...) for each issued asset. USDC/USDT on Stellar are
# `code:issuer` pairs — the same code from another issuer is a different, likely
# worthless, asset.
#   testnet: defaults to Circle's Centre testnet issuer
#            (GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5), which
#            issues both USDC and USDT. Leave blank to use it, or mint your own:
#            node scripts/stellar-issue-test-asset.mjs USDT
#   mainnet: REQUIRED. No default — verify the canonical issuer on
#            stellar.expert before pointing real money at it.
USDT_ASSET_ISSUER=
USDC_ASSET_ISSUER=

# --- Payment rail ---
PAYMENT_RAIL=mock                     # mock | pdax
PDAX_BASE_URL=https://services-stage.pdax.ph/api/exchange/v1
PDAX_ACCESS_KEY=
PDAX_SECRET=
PDAX_TOTP_SECRET=
# Deposit addresses. Optional for PAYMENT_RAIL=pdax-insti, which resolves them
# from GET /crypto/deposit (currency=XLM | USDCXLM | USDTXLM) along with the
# memo tag PDAX needs to credit the deposit. Set these only to pin an address;
# a pinned address always wins and is sent with no memo.
PDAX_XLM_DEPOSIT_ADDRESS=
PDAX_USDT_DEPOSIT_ADDRESS=
PDAX_USDC_DEPOSIT_ADDRESS=
# `<ASSET>PHP` pairs this PDAX account may trade. Pair availability is
# account-specific; all three were confirmed on the UAT sandbox. Unset = XLM only.
# NOTE: each pair has its own minimum trade size — UAT prices XLMPHP and USDCPHP
# from ₱100 but rejects USDTPHP below ~₱500 ("Order quantity is less than minimum
# required quantity"), which is why the rate probe escalates its amount.
PDAX_SETTLEMENT_ASSETS=XLM,USDC,USDT
# Per-pair OTC quantity step (PDAX rejects "Invalid Quantity Step" otherwise).
PDAX_INSTI_QTY_STEP_XLM=0.5
PDAX_INSTI_QTY_STEP_USDT=0.01
# Per-pair minimum sell size, enforced by PDAX in crypto units (probed on UAT).
PDAX_INSTI_MIN_QTY_XLM=10
PDAX_INSTI_MIN_QTY_USDC=1
PDAX_INSTI_MIN_QTY_USDT=2

# --- Settling an asset the rail cannot receive (Stellar DEX path payment) ---
# Head-room over the DEX quote, covering the book moving before submission.
SETTLEMENT_SLIPPAGE_BPS=100
# Refuse a conversion costing more than this above the asset's reference rate.
# Cheaper than reference is always allowed. 500 = 5%.
SETTLEMENT_MAX_PREMIUM_BPS=500

# --- Mock rail tuning (dev/CI only; ignored when PAYMENT_RAIL=pdax) ---
MOCK_XLM_PHP_RATE=3.50
MOCK_USDT_PHP_RATE=58.00
MOCK_USDC_PHP_RATE=58.00
MOCK_RAIL_DELAY_MS=0
MOCK_RAIL_FEE_RATE=0.01
MOCK_FAIL_PHP_AMOUNT=                  # optional: a PHP amount that forces settlement failure (e2e/demo)

# --- PDAX webhook (server-to-server callbacks) ---
PDAX_WEBHOOK_SECRET=                  # HMAC-SHA256 shared secret for X-PDAX-Signature
PDAX_WEBHOOK_IP_ALLOWLIST=            # optional CSV of allowed source IPs (empty = signature only)

# --- Object storage (MinIO dev / Railway prod, S3-compatible) ---
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_URL=http://localhost:9000   # base for signed GET URLs (prod: bucket/CDN URL)
S3_REGION=us-east-1
S3_BUCKET=heypay-uploads
S3_ACCESS_KEY=heypay
S3_SECRET_KEY=heypay-secret
S3_FORCE_PATH_STYLE=true              # true for MinIO; false for a real S3 endpoint

# --- Observability (optional) ---
SENTRY_DSN=

# --- E2E test overrides (used by playwright.config.ts; defaults shown) ---
E2E_PORT=3100
E2E_DATABASE_URL=postgresql://heypay:heypay@localhost:5433/heypay_e2e?schema=public
E2E_REDIS_URL=redis://localhost:6380
